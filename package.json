{
  "name": "triple-c-collective",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n pb,next -c yellow,cyan \"bun run pocketbase:run\" \"next dev\"",
    "build": "next build",
    "build:dev": "concurrently -n pb,next-builder -c yellow,cyan --kill-others \"bun run pocketbase:run\" \"next build\"",
    "start": "concurrently -n pb,next-builder -c yellow,cyan --kill-others \"bun run pocketbase:run\" \"next start\"",
    "preview": "concurrently -n pb,next -c yellow,cyan --kill-others \"bun run pocketbase:run\" \"dotenvx run -f .env.prod -- next start\"",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "pocketbase:build": "make -C pocketbase build",
    "pocketbase:run": "make -C pocketbase all",
    "pocketbase:clean": "make -C pocketbase clean",
    "pocketbase:test": "make -C pocketbase test",
    "pocketbase:admin": "concurrently \"bun run pocketbase:run\" \"open http://127.0.0.1:8090/_/\"",
    "lighthouse:run": "bun lighthouse/js/run-reports.mjs",
    "lighthouse:serve": "serve ./lighthouse/js/reports",
    "lighthouse": "bun run lighthouse:run && bun run lighthouse:serve",
    "email": "email dev --port 3050 --dir lib/emails"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx}": "bun lint",
    "*.{js,jsx,ts,tsx,css,md}": "bun format"
  },
  "dependencies": {
    "@bprogress/next": "^3.2.12",
    "@fireworks-js/react": "^2.10.8",
    "@js-temporal/polyfill": "^0.5.1",
    "@next/third-parties": "16.4.3",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-email/components": "^1.0.6",
    "@react-email/html": "0.0.12",
    "@react-email/render": "2.2.0",
    "@react-email/text": "0.1.6",
    "@smastrom/react-rating": "^1.5.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "chrome-launcher": "^1.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "husky": "^9.1.7",
    "lighthouse": "^13.6.0",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "node-gyp": "^13.1.0",
    "nodemailer": "^10.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "react-photo-view": "^1.2.7",
    "react-slick": "^0.31.0",
    "resend": "^6.37.0",
    "sharp": "^0.35.5",
    "slick-carousel": "^2.0.0",
    "tailwind-merge": "^3.7.0",
    "ts-pattern": "^5.9.2"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@react-email/preview-server": "^5.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/react": "^16.3.3",
    "@types/escape-html": "^1.0.4",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/react-slick": "^0.23.13",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.2",
    "baseline-browser-mapping": "^2.11.34",
    "bun-types": "^1.4.4",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "postcss": "^8.5.32",
    "react-email": "^6.11.6",
    "sass": "^1.107.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-motion": "^1.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "esbuild",
    "sharp"
  ]
}
